# 复制为 .env 后按需修改（本项目不依赖 python-dotenv，启动前手动设置环境变量即可）
# PowerShell:  $env:OLLAMA_MODEL="qwen2.5-coder:7b"; python app.py
# Bash:        export OLLAMA_MODEL=qwen2.5-coder:7b && python app.py

# ---- Ollama ----
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=bge-m3

# ---- 上下文预算 ----
# num_ctx 必须与显存匹配：8GB 显存跑 7B-Q4 建议 8192；更小的卡降到 4096
OLLAMA_NUM_CTX=8192
RESERVE_OUTPUT=1200

# ---- 检索 ----
RAG_TOP_K=3
# 阈值越高越保守（宁可说"没找到"也不瞎编）；实测相关 0.6~0.72，无关 0.3~0.39
RAG_MIN_SCORE=0.45
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBED_BATCH=16

# ---- Web ----
WEB_HOST=0.0.0.0
WEB_PORT=5000
MAX_UPLOAD_MB=50

# ---- 日志 ----
LOG_LEVEL=INFO
